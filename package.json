{
  "name": "squared-circle-manager",
  "productName": "Squared Circle Manager",
  "version": "0.9.0",
  "description": "A free wrestling promotion manager.",
  "main": "electron/main.js",
  "author": "Maciek",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:game": "bash src/build.sh && node scripts/prepare.js",
    "start": "npm run build:game && electron .",
    "dist": "npm run build:game && electron-builder --publish never",
    "release": "npm run build:game && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.ociapkowsky.squaredcirclemanager",
    "productName": "Squared Circle Manager",
    "files": [
      "electron/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-res"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-res/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build-res/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-res/icon.png",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ociapkowsky",
        "repo": "squared-circle-manager",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
